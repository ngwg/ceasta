// icon + version info for ceasta.exe
#include <winver.h>
#include "version.h"

1 ICON "ceasta.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CEASTA_VERSION_NUMBERS
PRODUCTVERSION CEASTA_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ceasta - disassembler, decompiler and debugger"
            VALUE "FileVersion", CEASTA_VERSION
            VALUE "InternalName", "ceasta"
            VALUE "OriginalFilename", "ceasta.exe"
            VALUE "ProductName", "ceasta"
            VALUE "ProductVersion", CEASTA_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
