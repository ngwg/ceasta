// icon + version info for ceasta.exe
#include <winver.h>

1 ICON "ceasta.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 6, 0, 0
PRODUCTVERSION 0, 6, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ceasta - disassembler and debugger"
            VALUE "FileVersion", "0.6.0"
            VALUE "InternalName", "ceasta"
            VALUE "OriginalFilename", "ceasta.exe"
            VALUE "ProductName", "ceasta"
            VALUE "ProductVersion", "0.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
